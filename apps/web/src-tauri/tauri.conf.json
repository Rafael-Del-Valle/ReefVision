{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "ReefVision",
  "mainBinaryName": "ReefVision",
  "version": "1.0.3",
  "identifier": "org.reefvision.desktop",
  "build": {
    "beforeDevCommand": "npm run ui:dev -- --host 127.0.0.1 --port 5173",
    "beforeBuildCommand": "npm run ui:build",
    "devUrl": "http://127.0.0.1:5173",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "ReefVision",
        "width": 1440,
        "height": 960,
        "minWidth": 1200,
        "minHeight": 760,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi"],
    "shortDescription": "Local-first scientific image annotation and computer vision platform.",
    "resources": {
      "../../../.desktop/release-1.0.3/backend/": "backend/",
      "../../../.desktop/release-1.0.3/bundled-models/": "bundled-models/"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "offlineInstaller",
        "silent": true
      },
      "wix": {
        "template": "windows/wix/main.wxs"
      }
    }
  }
}
