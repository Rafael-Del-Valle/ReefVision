{
  "name": "@reefvision/web",
  "private": true,
  "version": "1.0.2",
  "type": "module",
  "scripts": {
    "dev": "tauri dev",
    "build": "tsc -b && vite build --config vite.config.mjs --configLoader runner",
    "preview": "vite preview --config vite.config.mjs --configLoader runner",
    "desktop:dev": "tauri dev",
    "desktop:build": "tauri build --bundles msi",
    "lockfile:check": "node ./scripts/check-lockfile.mjs",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run --config vite.config.mjs --configLoader runner",
    "test:watch": "vitest --config vite.config.mjs --configLoader runner",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:e2e": "npm run ui:build && playwright test",
    "ui:dev": "vite --config vite.config.mjs --configLoader runner",
    "ui:build": "tsc -b && vite build --config vite.config.mjs --configLoader runner"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.0.0",
    "@tanstack/react-query": "^5.66.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@tauri-apps/cli": "^2.0.0",
    "@testing-library/jest-dom": "^6.6.0",
    "@testing-library/react": "^16.2.0",
    "@testing-library/user-event": "^14.6.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "jsdom": "^26.0.0",
    "prettier": "^3.5.0",
    "typescript": "~5.7.0",
    "vite": "^6.1.0",
    "vitest": "^3.0.0"
  },
  "engines": {
    "node": ">=22",
    "npm": ">=10"
  }
}
