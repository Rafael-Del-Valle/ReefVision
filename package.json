{
  "name": "reefvision-workspace",
  "private": true,
  "version": "1.0.3",
  "scripts": {
    "dev:web": "npm --prefix apps/web run dev",
    "dev:desktop": "npm --prefix apps/web run desktop:dev",
    "test:web": "npm --prefix apps/web run test",
    "build:web": "npm --prefix apps/web run build",
    "build:desktop": "powershell.exe -NoLogo -NoProfile -ExecutionPolicy Bypass -File ./scripts/build-desktop.ps1",
    "typecheck:web": "npm --prefix apps/web run typecheck",
    "test:e2e": "npm --prefix apps/web run test:e2e"
  },
  "engines": {
    "node": ">=22",
    "npm": ">=10"
  }
}
