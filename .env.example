REEFVISION_ENV=development
REEFVISION_API_HOST=127.0.0.1
REEFVISION_API_PORT=8000
REEFVISION_WEB_ORIGIN=http://localhost:5173
REEFVISION_DATA_DIR=.reefvision
REEFVISION_DATABASE_URL=sqlite:///.reefvision/reefvision.db
REEFVISION_BACKGROUND_WORKER_ENABLED=true
REEFVISION_WORKER_POLL_SECONDS=0.5
REEFVISION_THUMBNAIL_MAX_WIDTH=512
REEFVISION_THUMBNAIL_MAX_HEIGHT=512

# Disabled by default. Enabling this permits Workflow mask crops to be sent to
# configured remote vision reviewers and may incur API charges.
REEFVISION_ALLOW_REMOTE_VISION=false
REEFVISION_OPENAI_API_KEY=
REEFVISION_GEMINI_API_KEY=
REEFVISION_REMOTE_VISION_TIMEOUT_SECONDS=60

# Optional shared bearer token for the localhost SAM 3 sidecar.
REEFVISION_SAM3_SIDECAR_TOKEN=

VITE_API_BASE_URL=http://127.0.0.1:8000/api/v1
